[Unit]
Description=AXIOM narrowly scoped egress namespace provisioner
Requires=axiom-egress-provisioner.socket
After=network-pre.target
Before=axiom-egress-plane.service

[Service]
Type=exec
User=root
Group=root
EnvironmentFile=/etc/axiom/egress-provisioner.env
ExecStart=/usr/local/lib/axiom/egress-provisioner --socket /run/axiom/egress/provisioner.sock

# This is the sole long-lived process allowed to create/release AXIOM network
# namespaces and WireGuard interfaces.  It accepts only typed model lifecycle
# requests, never arbitrary commands, interface names, paths, or namespaces.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SETPCAP
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SETPCAP
NoNewPrivileges=no
PrivateNetwork=no
PrivateUsers=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
# Namespace creation is the provisioner's only exceptional duty. Do not copy
# this exception to the plane or runner units.
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ReadWritePaths=/run/axiom/egress /run/netns
UMask=0077
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
