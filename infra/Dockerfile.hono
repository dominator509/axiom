# =============================================================================
# Dockerfile.hono — Hono BFF (Backend-For-Frontend)
# Multi-stage: deps → builder → runner
# =============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Dependencies
# ------------------------------------------------------------------------------
FROM node:22-alpine AS deps

RUN apk add --no-cache libc6-compat

WORKDIR /app

RUN npm install -g pnpm@9.14.0

# Copy monorepo root manifests
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY patches ./patches

# Copy every workspace package manifest for dependency resolution. The API
# depends on the other workspace packages at build time, so copying only the
# API/dashboard manifests makes a clean frozen-lockfile build impossible.
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/core/package.json ./packages/core/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/connectors/package.json ./packages/connectors/package.json
COPY packages/relay/package.json ./packages/relay/package.json
COPY packages/llm-gateway/package.json ./packages/llm-gateway/package.json
COPY packages/fanvue-mcp/package.json ./packages/fanvue-mcp/package.json
COPY packages/mcp-server/package.json ./packages/mcp-server/package.json
COPY packages/worker/package.json ./packages/worker/package.json
COPY packages/mobile/package.json ./packages/mobile/package.json
COPY packages/api/package.json ./packages/api/package.json
COPY packages/dashboard/package.json ./packages/dashboard/package.json

RUN pnpm install --frozen-lockfile

# ------------------------------------------------------------------------------
# Stage 2: Builder
# ------------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@9.14.0

# Copy dependency artifacts from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/patches ./patches
COPY --from=deps /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY pnpm-workspace.yaml package.json ./
COPY tsconfig.base.json ./tsconfig.base.json

# Copy workspace source so TypeScript project references and runtime packages
# are available in the clean image build.
COPY packages ./packages

# Build the API and all of its workspace dependencies.
RUN pnpm --filter=@axiom/api... build

# Prune to production dependencies only
RUN pnpm --filter=@axiom/api --prod deploy /app/pruned

# Copy built artifacts into pruned directory
RUN cp -r packages/api/dist /app/pruned/dist

# ------------------------------------------------------------------------------
# Stage 3: Runner
# ------------------------------------------------------------------------------
FROM node:22-alpine AS runner

RUN addgroup --system --gid 1001 hono && \
    adduser --system --uid 1001 hono

WORKDIR /app

# Copy production code and dependencies
COPY --from=builder /app/pruned/node_modules ./node_modules
COPY --from=builder /app/pruned/dist ./dist
COPY --from=builder /app/pruned/package.json ./package.json

RUN chown -R hono:hono /app

USER hono

ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3001/health || exit 1

CMD ["node", "dist/index.js"]
