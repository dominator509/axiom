# =============================================================================
# Dockerfile.next — Next.js Dashboard
# Multi-stage: deps → builder → runner
# =============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Dependencies
# ------------------------------------------------------------------------------
FROM node:22-alpine AS deps

RUN apk add --no-cache libc6-compat

WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm@9.14.0

# Copy monorepo root manifests
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY patches ./patches

# Copy all workspace package.json files so pnpm can resolve the dependency graph
# before source code is copied. This keeps frozen-lockfile installs reproducible
# in a clean Docker context.
COPY packages/auth/package.json ./packages/auth/package.json
COPY packages/core/package.json ./packages/core/package.json
COPY packages/db/package.json ./packages/db/package.json
COPY packages/connectors/package.json ./packages/connectors/package.json
COPY packages/relay/package.json ./packages/relay/package.json
COPY packages/llm-gateway/package.json ./packages/llm-gateway/package.json
COPY packages/fanvue-mcp/package.json ./packages/fanvue-mcp/package.json
COPY packages/mcp-server/package.json ./packages/mcp-server/package.json
COPY packages/worker/package.json ./packages/worker/package.json
COPY packages/mobile/package.json ./packages/mobile/package.json
COPY packages/api/package.json ./packages/api/package.json
COPY packages/dashboard/package.json ./packages/dashboard/package.json

# Install with frozen lockfile for reproducibility
RUN pnpm install --frozen-lockfile

# ------------------------------------------------------------------------------
# Stage 2: Builder
# ------------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@9.14.0

# Copy node_modules and lockfile from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/patches ./patches
COPY --from=deps /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY pnpm-workspace.yaml package.json ./

# Copy source code for the entire monorepo (needed by build)
COPY . .
RUN mkdir -p packages/dashboard/public

# Build the dashboard and its workspace dependencies from a clean checkout.
RUN pnpm --filter=@axiom/dashboard... build

# Prune dev dependencies for production
RUN pnpm --filter=@axiom/dashboard --prod deploy /app/pruned

# ------------------------------------------------------------------------------
# Stage 3: Runner
# ------------------------------------------------------------------------------
FROM node:22-alpine AS runner

RUN addgroup --system --gid 1001 nextjs && \
    adduser --system --uid 1001 nextjs

WORKDIR /app

# Copy standalone build output from builder
COPY --from=builder /app/packages/dashboard/.next/standalone ./
COPY --from=builder /app/packages/dashboard/.next/static ./packages/dashboard/.next/static
COPY --from=builder /app/packages/dashboard/public ./packages/dashboard/public

# Copy the pruned production node_modules
COPY --from=builder /app/pruned/node_modules ./node_modules

RUN chown -R nextjs:nextjs /app

USER nextjs

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 -O /dev/null http://127.0.0.1:3000/login || exit 1

CMD ["node", "packages/dashboard/server.js"]
