# Disposable acceptance runner only; never a serving image.
FROM node:22.23.3-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
WORKDIR /work
RUN npm install -g pnpm@9.14.0
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY patches ./patches
COPY packages ./packages
RUN pnpm install --frozen-lockfile
RUN pnpm exec playwright install --with-deps chromium && \
    apt-get update && apt-get install -y --no-install-recommends postgresql-client openssl && \
    rm -rf /var/lib/apt/lists/*
COPY scripts/migrate.sh ./scripts/migrate.sh
COPY scripts/browser ./scripts/browser
RUN sed -i 's/\r$//' scripts/migrate.sh
CMD ["sleep", "infinity"]
