# =============================================================================
# Dockerfile.rust — Rust Hot-Path Plane (egress-plane)
# Multi-stage: builder → runner
# =============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Builder
# ------------------------------------------------------------------------------
FROM rust:1.97-slim-bookworm AS builder

# Install build dependencies needed by native Rust crates
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace Cargo config
COPY Cargo.toml Cargo.lock ./

# Copy individual crate manifests
COPY crates/egress-plane/Cargo.toml ./crates/egress-plane/Cargo.toml
COPY crates/media-plane/Cargo.toml ./crates/media-plane/Cargo.toml
COPY crates/vision-engine/Cargo.toml ./crates/vision-engine/Cargo.toml
COPY crates/scraper/Cargo.toml ./crates/scraper/Cargo.toml

# Copy the real source. The image build must fail on real compilation errors;
# there is no placeholder target or ignored build failure in the release path.
COPY crates/egress-plane/src ./crates/egress-plane/src
COPY crates/media-plane/src ./crates/media-plane/src
COPY crates/vision-engine/src ./crates/vision-engine/src
COPY crates/scraper/src ./crates/scraper/src

# Full release build with the real source
RUN cargo build --locked --release --package egress-plane

# ------------------------------------------------------------------------------
# Stage 2: Runtime
# ------------------------------------------------------------------------------
FROM debian:bookworm-slim AS runner

# The egress plane owns Linux namespace and firewall setup. Keep the image
# minimal, but ship the tools its production code invokes at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    iproute2 \
    iptables \
    wireguard-tools \
    && groupadd --system --gid 1001 egress \
    && useradd --system --uid 1001 --gid 1001 --home-dir /nonexistent --no-create-home egress \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the compiled binary from the builder stage
COPY --from=builder /app/target/release/egress-plane /app/egress-plane

# Run as a dedicated non-root identity. Deployment must grant only the
# capability required by the declared netns/WireGuard boundary.
USER 1001:1001

ENV LISTEN_ADDR=0.0.0.0:9090
EXPOSE 9090

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD ["/app/egress-plane", "--health"]

ENTRYPOINT ["/app/egress-plane"]
