{
  "name": "@axiom/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "clean": "node ../../scripts/clean.mjs dist"
  },
  "dependencies": {
    "@axiom/core": "workspace:*",
    "@axiom/db": "workspace:*",
    "@axiom/worker": "workspace:*",
    "@hono/zod-validator": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "uuid": "^11.1.1",
    "zod": "^3.23.0",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.0"
  }
}
