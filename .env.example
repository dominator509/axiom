# AXIOM FanvueCRM — Environment Variables

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/axiom

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-string
BETTER_AUTH_URL=http://localhost:3000

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug

# Platform API Keys
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=

# Encryption
MASTER_DEK=change-me-to-a-32-byte-hex-string
