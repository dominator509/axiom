# AXIOM FanvueCRM — Environment Variables

# PostgreSQL
DATABASE_URL=postgresql://axiom_app:changeme@localhost:5432/axiom
# Local bootstrap role for scripts/migrate.sh. Production must use a separate
# least-privilege runtime role and dedicated DDL/migrator role.
MIGRATOR_DATABASE_URL=postgresql://axiom_migrator:changeme@localhost:5432/axiom
TEST_DATABASE_URL=postgresql://axiom_app:changeme@localhost:5432/axiom_test

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-string
BETTER_AUTH_URL=http://localhost:3000

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Provider-facing media delivery. The worker keeps the storage key for the
# local Rust media plane and maps it under this HTTPS base URL before a social
# connector is called. Do not point this at the loopback media plane.
AXIOM_ASSET_DELIVERY_BASE_URL=https://media.example.com/assets/

AXIOM_VISION_MODEL=/absolute/path/to/nsfw-vit.onnx

# Logging
LOG_LEVEL=debug

# Platform API Keys
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=

# Encryption
EGRESS_DEK=change-me-to-a-64-character-hex-string
