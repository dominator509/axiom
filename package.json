{
  "name": "axiom-fanvue-crm",
  "version": "0.1.0",
  "private": true,
  "description": "AXIOM FanvueCRM — Enterprise CRM for Fanvue models",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
