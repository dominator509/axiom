{
  "name": "axiom-fanvue-crm",
  "version": "0.1.0",
  "private": true,
  "description": "AXIOM FanvueCRM — Enterprise CRM for Fanvue models",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "clean": "turbo run clean",
    "lint-all": "bash scripts/lint.sh",
    "test-all": "bash scripts/test.sh",
    "test-unit": "bash scripts/test-unit.sh",
    "migrate": "bash scripts/migrate.sh",
    "setup-dev": "bash scripts/setup-dev.sh",
    "security-check": "bash scripts/security-check.sh",
    "test-security-patches": "node scripts/test-patched-dependencies.mjs",
    "audit:dependencies": "node scripts/audit-pnpm.mjs",
    "setup:vision-model": "sh scripts/fetch-vision-model.sh"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.14.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@9.14.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "@xmldom/xmldom": "0.8.13",
      "brace-expansion": "2.1.4",
      "hono": "4.12.34",
      "js-yaml": "3.15.1",
      "nanoid": "3.3.17",
      "postcss": "8.5.25",
      "sharp": "0.35.0",
      "tar": "7.5.21",
      "uuid": "11.1.1",
      "vite": "6.4.3"
    },
    "patchedDependencies": {
      "image-size@1.2.1": "patches/image-size@1.2.1.patch"
    }
  }
}
